<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nira_viz</name>
  <version>0.0.1</version>
  <description>Desktop visualization and offline launch files for Nira</description>
  <maintainer email="stein.robotics@gmail.com">christian</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>nira_brain</exec_depend>
  <exec_depend>nira_communication</exec_depend>
  <exec_depend>nira_description</exec_depend>
  <exec_depend>nira_hmi</exec_depend>
  <exec_depend>nira_perception_face</exec_depend>
  <exec_depend>nira_camera</exec_depend>
  <exec_depend>python3-pyside6.qtwidgets</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nira_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>nira_movement</exec_depend>
  <exec_depend>nira_navigation</exec_depend>
  <exec_depend>nira_teleop</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>nira_bringup</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
