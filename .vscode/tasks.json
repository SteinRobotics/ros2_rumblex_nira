{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "colcon: build (workspace)",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/build.sh"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "colcon: build (package and dependencies)",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/build.sh",
                "${input:packageName}"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "packageName",
            "type": "pickString",
            "description": "Select the package to build with its dependencies",
            "options": [
                "nira_brain",
                "nira_bringup",
                "nira_camera",
                "nira_communication",
                "nira_description",
                "nira_gazebo",
                "nira_hmi",
                "nira_interfaces",
                "nira_lidar_2d",
                "nira_movement",
                "nira_navigation",
                "nira_perception_face",
                "nira_teleop",
                "nira_utils"
            ],
            "default": "nira_movement"
        }
    ]
}
